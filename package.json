{
  "name": "smithers-plugins",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Vendor agent adapters, provider seats, and deployment hosts for Smithers",
  "license": "MIT",
  "workspaces": [
    "packages/adapters",
    "packages/accounts",
    "packages/usage",
    "packages/seat-resolver",
    "packages/provider-kit",
    "packages/host-cloudflare",
    "packages/host-vercel",
    "packages/host-microsandbox"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.21.0"
}
