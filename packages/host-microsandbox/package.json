{
  "name": "@smthrs-plugins/host-microsandbox",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "description": "Microsandbox remote spawner and health provider for Smithers",
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "node ../../scripts/check-source.mjs",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "4.0.0-rc.108",
    "@smthrs/sandbox": "1.0.0-rc.0",
    "@smthrs-plugins/provider-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "microsandbox": "0.6.6"
  },
  "peerDependencies": {
    "microsandbox": "0.6.6"
  },
  "peerDependenciesMeta": {
    "microsandbox": {
      "optional": true
    }
  }
}
