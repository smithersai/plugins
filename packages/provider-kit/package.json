{
  "name": "@smthrs-plugins/provider-kit",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "description": "Command sandbox provider kit, egress policy, and bundling for Smithers hosts",
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "link:../../../smithers-v1/node_modules/effect",
    "@smthrs/kernel": "link:../../../smithers-v1/packages/kernel",
    "@smthrs/sandbox": "link:../../../smithers-v1/packages/sandbox",
    "@smthrs/core": "link:../../../smithers-v1/packages/core"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "@effect/platform-node": "link:../../../smithers-v1/node_modules/@effect/platform-node"
  }
}
