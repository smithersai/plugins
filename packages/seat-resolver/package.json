{
  "name": "@smthrs-plugins/seat-resolver",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "description": "A Smithers SeatResolver over the account registry with a fallback seat pool",
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "4.0.0-rc.108",
    "@smthrs/agent": "1.0.0-rc.0",
    "@smthrs/model": "1.0.0-rc.0",
    "@smthrs-plugins/accounts": "workspace:*",
    "@smthrs-plugins/usage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "@effect/platform-node": "4.0.0-rc.108"
  }
}
